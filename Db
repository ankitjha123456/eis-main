// ══════════ Who Am I ══════════
app.post('/api/tfs-whoami', async (req, res) => {
  const { tfsUrl, collection, project, repo, authMode, username, password, directUrl } = req.body;
  const mode = ['pat', 'winauth'].includes(authMode) ? authMode : 'basic';
  
  try {
    const identity = await resolveIdentity({ tfsUrl, collection, project, repo, authMode: mode, username, password, directUrl });
