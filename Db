#!/bin/bash

output_file="/home/tdbd/checklist_data.json"
rows=()

# Initialize serial number
sr_no=1

# Escapes a string for safe inclusion inside JSON double quotes.
# No external tools (jq/python) required — pure bash string substitution.
json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"   # backslash
    s="${s//\"/\\\"}"   # double quote
    s="${s//$'\t'/\\t}" # tab
    s="${s//$'\n'/\\n}" # newline
    s="${s//$'\r'/\\r}" # carriage return
    printf '%s' "$s"
}

# Returns the numeric value as-is if it looks like a number, otherwise "null"
json_number_or_null() {
    local v="$1"
    if [[ "$v" =~ ^-?[0-9]+([.][0-9]+)?$ ]]; then
        printf '%s' "$v"
    else
        printf 'null'
    fi
}

for ip in {50..70} {162..165} 79 180; do
    server="10.177.44.$ip"

    if [[ $ip -ge 50 && $ip -le 57 ]]; then
        application="EXP"
    elif [[ $ip -ge 60 && $ip -le 67 ]]; then
        application="SYS"
    elif [[ $ip -eq 69 || $ip -eq 70 ]]; then
        application="MQ"
    elif [[ $ip -ge 162 && $ip -le 165 ]]; then
        application="Dynatrace Cluster Node"
    elif [[ $ip -eq 79 ]]; then
        application="Ansible Control Node"
    elif [[ $ip -eq 180 ]]; then
        application="SFTP"
    else
        application="N/A"
    fi

    if [[ $ip -eq 58 || $ip -eq 59 || $ip -eq 68 ]]; then
        port_status="Down"
    else
        port_status="Up"
    fi

    # SSH to get system info
    system_info=$(ssh -q eisuser@$server "
    load_avg=\$(uptime | awk -F 'load average: ' '{split(\$2, a, \", \"); avg = (a[1] + a[2] + a[3]) / 3; print (avg < 1) ? 1 : int(avg + 0.5)}')
    mem_utilization=\$(free -g | awk '/Mem:/ {print \$3}')
    uptime_value=\$(uptime | awk -F ',' '{print \$1}')
    dfUtl=\$(df -hT | awk 'NR > 1 { gsub(/%/, \"\", \$6); if (\$6+0 >= 75) { print \"problem\"; exit }} END { print \"Ok\"; }')
    echo \"\$uptime_value,\$load_avg,\$mem_utilization,\$dfUtl\"
    " 2>/dev/null)

    IFS=',' read -r uptime_value load_avg mem_utilization dfUtl <<< "$system_info"

    [[ -z "$dfUtl" ]] && dfUtl="Unknown"

    # Build one JSON object for this row using plain string concatenation
    row_json=$(printf '{"srNo":%s,"server":"%s","application":"%s","uptime":"%s","cpuUtilization":%s,"memUtilization":%s,"diskStatus":"%s","portStatus":"%s"}' \
        "$sr_no" \
        "$(json_escape "$server")" \
        "$(json_escape "$application")" \
        "$(json_escape "$uptime_value")" \
        "$(json_number_or_null "$load_avg")" \
        "$(json_number_or_null "$mem_utilization")" \
        "$(json_escape "$dfUtl")" \
        "$(json_escape "$port_status")")

    rows+=("$row_json")

    echo "Data collected for $server"
    ((sr_no++))
done

# Combine all row objects into a single JSON array (comma-joined, no jq needed)
{
    echo "["
    for i in "${!rows[@]}"; do
        if [[ $i -lt $((${#rows[@]} - 1)) ]]; then
            echo "  ${rows[$i]},"
        else
            echo "  ${rows[$i]}"
        fi
    done
    echo "]"
} > "$output_file"

echo "JSON report written to $output_file"
