[eisuser@EISUATEXP09 tdbd]$ cat /home/ankit/checklist1.sh
output_file="/home/tdbd/checklist1.html"

# Start HTML with CSS
cat <<EOF > "$output_file"
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Server Checklist Report</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            padding: 20px;
        }
        h2 {
            color: #333;
            text-align: center;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background-color: #fff;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        th, td {
            border: 1px solid #ccc;
            padding: 10px;
            text-align: center;
        }
        th {
            background-color: #007BFF;
            color: white;
        }
        tr:nth-child(even) {
            background-color: #f2f2f2;
        }
        .down {
            background-color: #ffdddd;
            color: red;
        }
        .ok {
            color: green;
        }
    </style>
</head>
<body>
    <h2>UAT Checklist Report</h2>
    <table>
        <tr>
            <th>Sr. No</th>
            <th>UAT Server</th>
            <th>Application</th>
            <th>Uptime</th>
            <th>CPU Utilization</th>
            <th>Memory Utilization</th>
            <th>Disk Utilization</th>
            <th>Port Status</th>
        </tr>
EOF

# Initialize serial number
sr_no=1

for ip in {50..70} {162..165} 79 180; do
    server="10.177.44.$ip"

    if [[ $ip -ge 50 && $ip -le 57 ]]; then
        application="EXP"
    elif [[ $ip -ge 60 && $ip -le 67 ]]; then
        application="SYS"
    elif [[ $ip -eq 69 || $ip -eq 70 ]]; then
        application="MQ"
    elif [[ $ip -ge 162 && $ip -le 165 ]]; then
        application="Dynatrace Cluster Node"
    elif [[ $ip -eq 79 ]]; then
        application="Ansible Control Node"
    elif [[ $ip -eq 180 ]]; then
        application="SFTP"
    else
        application="N/A"
    fi

    if [[ $ip -eq 58 || $ip -eq 59 || $ip -eq 68 ]]; then
        port_status="Down"
        port_class="down"
    else
        port_status="Up"
        port_class=""
    fi

    # SSH to get system info
    system_info=$(ssh -q eisuser@$server "
    load_avg=\$(uptime | awk -F 'load average: ' '{split(\$2, a, \", \"); avg = (a[1] + a[2] + a[3]) / 3; print (avg < 1) ? 1 : int(avg + 0.5)}')
    mem_utilization=\$(free -g | awk '/Mem:/ {print \$3}')
    uptime_value=\$(uptime | awk -F ',' '{print \$1}')
    dfUtl=\$(df -hT | awk 'NR > 1 { gsub(/%/, \"\", \$6); if (\$6+0 >= 75) { print \"problem\"; exit }} END { print \"Ok\"; }')
    echo \"\$uptime_value,\$load_avg,\$mem_utilization,\$dfUtl\"
    " 2>/dev/null)

    IFS=',' read -r uptime_value load_avg mem_utilization dfUtl <<< "$system_info"

    # Append row to HTML
    echo "        <tr>" >> "$output_file"
    echo "            <td>$sr_no</td>" >> "$output_file"
    echo "            <td>$server</td>" >> "$output_file"
    echo "            <td>$application</td>" >> "$output_file"
    echo "            <td>$uptime_value</td>" >> "$output_file"
    echo "            <td>$load_avg</td>" >> "$output_file"
    echo "            <td>$mem_utilization</td>" >> "$output_file"
    echo "            <td class='$( [[ \"$dfUtl\" == \"problem\" ]] && echo "down" || echo "ok" )'>$dfUtl</td>" >> "$output_file"
    echo "            <td class='$port_class'>$port_status</td>" >> "$output_file"
    echo "        </tr>" >> "$output_file"

    echo "Data collected for $server"
    ((sr_no++))
done

# Close HTML
echo "    </table>" >> "$output_file"
echo "</body></html>" >> "$output_file"
