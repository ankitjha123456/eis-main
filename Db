// ══════════ Utility Functions ══════════
function sendJson(res, status, data) {
  res.status(status).json(data);
}

function safeName(name) {
  return name.replace(/[^a-zA-Z0-9]/g, '_').toLowerCase();
}

async function run(cmd, cwd, timeout = 60000, creds) {
  const env = { ...process.env };
  if (creds && creds.username && creds.password) {
    // For basic auth with git
    env.GIT_ASKPASS = 'echo';
    env.GIT_USERNAME = creds.username;
    env.GIT_PASSWORD = creds.password;
  }
  const options = { cwd: cwd || process.cwd(), timeout, env, shell: true };
  try {
    const { stdout, stderr } = await execAsync(cmd, options);
    return stdout;
  } catch (err) {
    if (err.stdout) throw new Error(err.stdout);
    if (err.stderr) throw new Error(err.stderr);
    throw err;
  }
}

async function extractZip(zipPath, destDir) {
  fs.mkdirSync(destDir, { recursive: true });
  
  // Try using system unzip first
  try {
    await run(`unzip -o "${zipPath}" -d "${destDir}"`);
    return;
  } catch (e) {
    console.log('System unzip failed, trying Node.js unzipper...');
  }
  
  // Fallback to Node.js unzipper
  const stream = fs.createReadStream(zipPath).pipe(unzipper.Extract({ path: destDir }));
  return new Promise((resolve, reject) => {
    stream.on('finish', resolve);
    stream.on('error', reject);
  });
}

// ══════════ Identity Resolution ══════════
async function resolveIdentity({ tfsUrl, collection, project, repo, authMode, username, password, directUrl }) {
  // Try TFS API to get the user's display name
  const apiUrl = `${tfsUrl}/${collection}/_apis/connectionData?api-version=6.0`;
  const auth = authMode === 'pat' 
    ? { headers: { 'Authorization': `Bearer ${password}` } }
    : authMode === 'winauth'
    ? { headers: { 'Authorization': 'Negotiate' }, httpsAgent: new (require('https').Agent)({ rejectUnauthorized: false }) }
    : { auth: { username, password } };
  
  try {
    const response = await axios.get(apiUrl, { 
      ...auth,
      timeout: 10000,
      httpsAgent: new (require('https').Agent)({ rejectUnauthorized: false })
    });
    const data = response.data;
    const authenticatedUser = data.authenticatedUser || {};
    const name = authenticatedUser.displayName || authenticatedUser.providerDisplayName || authenticatedUser.uniqueName || username || 'Unknown User';
    
    return { 
      name, 
      verifiedVia: authMode,
      isOpaqueId: !authenticatedUser.displayName
    };
  } catch (err) {
    console.log('Identity API failed, falling back to provided credentials:', err.message);
    // Fallback: use the provided username or a default
    if (authMode === 'basic' && username) {
      return { name: username, verifiedVia: 'basic-fallback', isOpaqueId: true };
    }
    if (authMode === 'winauth') {
      // Try to get OS username
      try {
        const whoami = await run('whoami');
        return { name: whoami.trim(), verifiedVia: 'os', isOpaqueId: true };
      } catch (e) {}
    }
    throw new Error(`Could not resolve identity from TFS: ${err.message}`);
  }
}

