    sendJson(res, 200, { ok: false, message: err.message });
  }
});

// ══════════ Main Check-in Endpoint ══════════
async function handleCheckin(body, res) {
  const {
    zipBase64, zipName, repo, branch, feature, workItem, message,
    tfsUrl, clonePath, targetDir, collection, project, authMode, username, password, directUrl
  } = body;
  
  const mode = ['pat', 'winauth'].includes(authMode) ? authMode : 'basic';
  if (!zipBase64) return sendJson(res, 200, { ok: false, message: 'No zip data received' });
  if (!repo) return sendJson(res, 200, { ok: false, message: 'repo is required' });
  if (!branch) return sendJson(res, 200, { ok: false, message: 'branch is required' });
  if (mode === 'basic' && !username) return sendJson(res, 200, { ok: false, message: 'TFS username is required' });
  if (!password) return sendJson(res, 200, { ok: false, message: mode === 'basic' ? 'password is required' : 'A PAT is required for the actual git push' });
  
  let identity;
  try {
    identity = await resolveIdentity({ tfsUrl, collection, project, repo, authMode: mode, username, password, directUrl });
  } catch (err) {
    return sendJson(res, 200, { ok: false, message: `Identity verification failed — check-in blocked: ${err.message}` });
  }
  
  const author = identity.name;
  const authorEmail = `${safeName(author).toLowerCase()}@local`;
  
  // Build the TFS remote URL
  const plainRemote = `${tfsUrl}/${collection}/${project}/_git/${repo}`;
  
  const workDir = clonePath && path.isAbsolute(clonePath)
    ? clonePath
    : path.join(os.tmpdir(), 'tfs-ci', safeName(repo));

  const tmpRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'tfs-ci-zip-'));
  const zipPath = path.join(tmpRoot, zipName || 'package.zip');
  const extractDir = path.join(tmpRoot, 'extracted');

  const log = [];
  const step = (s) => log.push(s);

  try {
    step(`Verified identity — checking in as "${author}"`);
    
    // 1. Decode & extract the uploaded zip
    step('Decoding uploaded zip...');
    fs.writeFileSync(zipPath, Buffer.from(zipBase64, 'base64'));
    step('Extracting zip...');
    await extractZip(zipPath, extractDir);

    // 2. Ensure we have a local clone
    fs.mkdirSync(path.dirname(workDir), { recursive: true });
    
    // Check if tf command is available
    const tfPath = process.env.TF_PATH || 'tf';
    let tfCmd = tfPath;
    
    // For Git repositories on TFS
    const remote = `${tfsUrl}/${collection}/${project}/_git/${repo}`;
    const gitDir = path.join(workDir, '.git');
    
    if (!fs.existsSync(gitDir)) {
      step(`Cloning repository...`);
      try {
        await run(`git clone ${remote} "${workDir}"`, undefined, 120000);
      } catch (e) {
        step('Clone failed, initializing empty repo...');
        fs.mkdirSync(workDir, { recursive: true });
        await run(`git init`, workDir);
        await run(`git remote add origin ${remote}`, workDir);
      }
    }

    // 3. Checkout/Create branch
    step(`Checking out branch "${branch}"`);
    try {
      await run(`git checkout ${branch}`, workDir);
      await run(`git reset --hard origin/${branch}`, workDir).catch(() => {});
    } catch (e) {
      try {
        await run(`git checkout -b ${branch} origin/${branch}`, workDir);
      } catch (e2) {
        await run(`git checkout -b ${branch}`, workDir);
      }
    }

    // 4. Copy extracted files
    const dest = targetDir ? path.join(workDir, targetDir) : workDir;
    fs.mkdirSync(dest, { recursive: true });
    step(`Copying files to ${dest}`);
    fs.cpSync(extractDir, dest, { recursive: true, force: true });

    // 5. Git config
    await run(`git config user.email "apidev.eis@sbi.co.in"`, workDir);
    await run(`git config user.name "${author}"`, workDir);

    // 6. Stage and commit
    await run(`git add -A`, workDir);
    const statusOut = await run(`git status --porcelain`, workDir);
    if (!statusOut.trim()) {
      return sendJson(res, 200, { ok: false, message: 'Nothing to commit — no file changes detected', log });
    }

    const commitMsg = message || `[${workItem || feature || 'CI'}] Automated check-in for ${feature || repo}`;
    step(`Committing as "${author}"...`);
    await run(`git commit -m "${commitMsg}" --author="${author} <${authorEmail}>"`, workDir);

    // 7. Push
    step(`Pushing to origin/${branch}...`);
    const pushCmd = `git push origin HEAD:${branch}`;
    if (mode === 'basic' && username && password) {
      // Use credential helper for basic auth
      await run(`git config credential.helper store`, workDir);
      await run(`echo "https://${username}:${password}@${tfsUrl.replace(/^https?:\/\//, '')}" > ${path.join(workDir, '.git', 'credentials')}`, workDir);
    } else if (mode === 'pat') {
      await run(`git config credential.helper store`, workDir);
      const patUrl = tfsUrl.replace(/^https?:\/\//, '');
      await run(`echo "https://PAT:${password}@${patUrl}" > ${path.join(workDir, '.git', 'credentials')}`, workDir);
    }
    await run(pushCmd, workDir, 120000);

    const shortHash = await run(`git rev-parse --short HEAD`, workDir);
    const filesChanged = statusOut.split('\n').filter(Boolean).length;

    return sendJson(res, 200, {
      ok: true,
      commit: shortHash.trim(),
      branch,
      author,
      filesChanged,
      message: `Checked in as commit ${shortHash.trim()} (author: ${author})`,
      buildTriggered: false,
      log
    });
  } catch (err) {
    return sendJson(res, 200, { ok: false, message: err.message, log });
  } finally {
    fs.rmSync(tmpRoot, { recursive: true, force: true });
  }
}

app.post('/api/tfs-checkin', async (req, res) => {
  await handleCheckin(req.body, res);
